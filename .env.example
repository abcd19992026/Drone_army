# GSS configuration. Copy to .env and edit as needed.
# Every value here is also the built-in default, so a .env file is optional.
# On the real drone, ONLY MAVLINK_CONNECTION changes.

# --- Link ---
# SITL over TCP. On real hardware use a serial port, e.g. COM4 or
# /dev/serial0 with a baud suffix: "/dev/serial0,57600".
MAVLINK_CONNECTION=tcp:127.0.0.1:5762

# --- Dock / home location (decimal degrees) ---
HOME_LAT=25.5932
HOME_LON=85.2045

# --- Altitudes (metres) ---
CRUISE_ALT_INBOUND=45
CRUISE_ALT_OUTBOUND=55
ON_STATION_ALT=28
LATERAL_OFFSET_M=12

# --- Geofence ---
MAX_RADIUS_M=6000
MAX_ALT_M=60

# --- Battery ladder (percent) ---
BATTERY_WARN_PCT=40
BATTERY_FLOOR_PCT=20

# --- Recording retention (days) ---
RECORDING_KEEP_DAYS=30

# --- Timing (seconds) ---
TELEMETRY_INTERVAL_S=2.0
HEARTBEAT_TIMEOUT_S=5.0

# --- Reconnect backoff (seconds) ---
RECONNECT_BACKOFF_START_S=1.0
RECONNECT_BACKOFF_CAP_S=5.0

# --- Telemetry stream rates (Hz) ---
STREAM_RATE_POSITION_HZ=4.0
STREAM_RATE_VFR_HZ=2.0
STREAM_RATE_STATUS_HZ=1.0
STREAM_RATE_GPS_HZ=1.0

# --- Stream watchdog (seconds) ---
# If the link is up but no telemetry has arrived for STREAM_WATCHDOG_S,
# re-request the streams, no more often than every STREAM_REREQUEST_MIN_S.
STREAM_WATCHDOG_S=5.0
STREAM_REREQUEST_MIN_S=2.0

# --- Supabase sync (v0.2) ---
# SUPABASE_ENABLED=false runs the GSS exactly as v0.1.1: console only, zero
# network calls. When true, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# REQUIRED -- the GSS refuses to start without them rather than silently
# running with no persistence.
SUPABASE_ENABLED=true
SUPABASE_URL=https://icjkxnyiifixunujsmkz.supabase.co
# service_role key -- bypasses RLS. Dock Pi only. NEVER commit the real value,
# NEVER put it in web/ or a browser. Fill it in .env (gitignored), not here.
SUPABASE_SERVICE_ROLE_KEY=
# Row ids to write. Defaults match the seed migration under supabase/migrations/.
DRONE_ID=d5030000-0000-4000-8000-000000000001
DOCK_ID=d0c00000-0000-4000-8000-000000000001
# Supabase write cadence, independent of the console print interval.
SUPABASE_TELEMETRY_INTERVAL_S=2.0
# Force a write at least this often even if nothing changed (proves liveness).
SUPABASE_HEARTBEAT_WRITE_S=15.0
# Bounded outbound queue; oldest entries are dropped when Supabase is slow.
SUPABASE_QUEUE_MAX=200

# --- Command intake (v0.3) ---
# Realtime is the fast path; this poll is the guaranteed one.
COMMAND_POLL_INTERVAL_S=3.0
# Expiry for a command with no expires_at = issued_at + this (evaluated
# against the DATABASE clock, never the Pi's).
COMMAND_DEFAULT_TTL_S=120.0
# A flight command is only accepted while telemetry is at most this stale.
TELEMETRY_MAX_AGE_S=10.0
# Hard stop for a mission that never reaches a terminal state.
MISSION_MAX_DURATION_S=900.0
# GUARD RAIL -- must be false. The GSS refuses to start otherwise: there is
# no safety.py (v0.4) and no real executor (v0.5) yet. v0.3 is dry-run only.
ALLOW_VEHICLE_CONTROL=true

# --- Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG ---
LOG_LEVEL=INFO
# Rotating log file alongside the console -- empty disables it. Without this,
# a crash traceback only ever reaches whatever console happens to be
# watching gss.main, which on an unattended dock is nobody.
LOG_FILE_PATH=./gss.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# --- WhatsApp SOS alerts (Phase 11) ---
# ALERTS_ENABLED=false means gss/commands.py never even imports gss.alerts;
# an "sos" command still flies, it just sends no WhatsApp message.
ALERTS_ENABLED=true
# The live status page FRONTEND (map/location/Call Police button) doesn't
# exist yet -- a later phase. Its backend does: an anon-callable Postgres
# function, get_sos_incident_status(p_command_id) -- see
# supabase/migrations/20260918120000_public_sos_status.sql. Once you deploy
# the frontend, set this to its real base URL (no further code change is
# needed here) -- until then, leave the obviously-fake default. The WhatsApp
# message links to f"{STATUS_PAGE_BASE_URL}/{command_id}" -- the id of the
# claimed "sos" command, not a mission id (no mission may exist yet).
STATUS_PAGE_BASE_URL=http://TODO-status-page.example
# WhatsApp Business Cloud API (Meta). WABA_ACCESS_TOKEN MUST be a PERMANENT
# System User token (Meta Business Settings -> System Users), never a
# short-lived one -- see gss/config.py for why. Never commit real values.
WABA_ID=
WABA_PHONE_NUMBER_ID=
WABA_ACCESS_TOKEN=
# No approved template yet -- leave blank until one exists.
WABA_TEMPLATE_NAME=
WABA_TEMPLATE_LANG=en
# {{1}} in the sos_alert template body -- the name that goes out to the
# trusted contacts, e.g. "SOS Alert from <this>." Leave the obviously-fake
# default (see gss/config.py) until set.
SOS_PERSON_NAME=

# --- Find-my-drone beacon (Phase 12) ---
# BEACON_ENABLED=false means gss/main.py never imports gss.beacon.
BEACON_ENABLED=true
BEACON_TICK_S=2.0
# Stays false until real payload hardware exists and is wired into
# gss/payload.py's RealPayloadActuator -- see that module.
PAYLOAD_HARDWARE_ENABLED=false
# Fallbacks only -- the real, operator-tunable values live in the
# `system_config` table (beacon.link_loss_activate_delay_s /
# beacon.ground_continuous_s / beacon.periodic_interval_s), read once at
# BeaconMonitor construction. periodic_on_s has no system_config row.
BEACON_ACTIVATE_DELAY_S_DEFAULT=30
BEACON_CONTINUOUS_S_DEFAULT=120
BEACON_PERIODIC_INTERVAL_S_DEFAULT=300
BEACON_PERIODIC_ON_S_DEFAULT=15
