# GSS configuration. Copy to .env and edit as needed.
# Every value here is also the built-in default, so a .env file is optional.
# On the real drone, ONLY MAVLINK_CONNECTION changes.

# --- Link ---
# SITL over TCP. On real hardware use a serial port, e.g. COM4 or
# /dev/serial0 with a baud suffix: "/dev/serial0,57600".
MAVLINK_CONNECTION=tcp:127.0.0.1:5762

# --- Dock / home location (decimal degrees) ---
HOME_LAT=25.5932
HOME_LON=85.2045

# --- Altitudes (metres) ---
CRUISE_ALT_INBOUND=45
CRUISE_ALT_OUTBOUND=55
ON_STATION_ALT=28
LATERAL_OFFSET_M=12

# --- Geofence ---
MAX_RADIUS_M=6000
MAX_ALT_M=60

# --- Battery ladder (percent) ---
BATTERY_WARN_PCT=40
BATTERY_FLOOR_PCT=20

# --- Recording retention (days) ---
RECORDING_KEEP_DAYS=30

# --- Timing (seconds) ---
TELEMETRY_INTERVAL_S=2.0
HEARTBEAT_TIMEOUT_S=5.0

# --- Reconnect backoff (seconds) ---
RECONNECT_BACKOFF_START_S=1.0
RECONNECT_BACKOFF_CAP_S=5.0

# --- Telemetry stream rates (Hz) ---
STREAM_RATE_POSITION_HZ=4.0
STREAM_RATE_VFR_HZ=2.0
STREAM_RATE_STATUS_HZ=1.0
STREAM_RATE_GPS_HZ=1.0

# --- Stream watchdog (seconds) ---
# If the link is up but no telemetry has arrived for STREAM_WATCHDOG_S,
# re-request the streams, no more often than every STREAM_REREQUEST_MIN_S.
STREAM_WATCHDOG_S=5.0
STREAM_REREQUEST_MIN_S=2.0

# --- Supabase sync (v0.2) ---
# SUPABASE_ENABLED=false runs the GSS exactly as v0.1.1: console only, zero
# network calls. When true, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# REQUIRED -- the GSS refuses to start without them rather than silently
# running with no persistence.
SUPABASE_ENABLED=true
SUPABASE_URL=https://icjkxnyiifixunujsmkz.supabase.co
# service_role key -- bypasses RLS. Dock Pi only. NEVER commit the real value,
# NEVER put it in web/ or a browser. Fill it in .env (gitignored), not here.
SUPABASE_SERVICE_ROLE_KEY=
# Row ids to write. Defaults match the seed migration under supabase/migrations/.
DRONE_ID=d5030000-0000-4000-8000-000000000001
DOCK_ID=d0c00000-0000-4000-8000-000000000001
# Supabase write cadence, independent of the console print interval.
SUPABASE_TELEMETRY_INTERVAL_S=2.0
# Force a write at least this often even if nothing changed (proves liveness).
SUPABASE_HEARTBEAT_WRITE_S=15.0
# Bounded outbound queue; oldest entries are dropped when Supabase is slow.
SUPABASE_QUEUE_MAX=200

# --- Command intake (v0.3) ---
# Realtime is the fast path; this poll is the guaranteed one.
COMMAND_POLL_INTERVAL_S=3.0
# Expiry for a command with no expires_at = issued_at + this (evaluated
# against the DATABASE clock, never the Pi's).
COMMAND_DEFAULT_TTL_S=120.0
# A flight command is only accepted while telemetry is at most this stale.
TELEMETRY_MAX_AGE_S=10.0
# Hard stop for a mission that never reaches a terminal state.
MISSION_MAX_DURATION_S=900.0
# GUARD RAIL -- must be false. The GSS refuses to start otherwise: there is
# no safety.py (v0.4) and no real executor (v0.5) yet. v0.3 is dry-run only.
ALLOW_VEHICLE_CONTROL=false

# --- Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG ---
LOG_LEVEL=INFO
